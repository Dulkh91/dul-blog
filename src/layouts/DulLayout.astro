---
import '../styles/global.css'
import  Footer  from '@components/Footer.astro';
import  HomeLink from '@components/HomeLink.astro';
import  ThemeToggle from '@components/ThemeToggle.astro';
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script is:inlinml-auto  items-center space-x-2e>
			try {
				if (localStorage.getItem('blog-theme') === 'dark') document.documentElement.classList.add('dark');
			} catch {}
	</script>
    <title>dul page</title>
</head>
<body class=" flex flex-col bg-surface-light dark:bg-surface-dark dark:text-zinc-100 transition-colors duration-300 min-h-screen  ">
    <header class=" sticky  top-0 z-40 w-full  backdrop-blur-md bg-white/80 dark:bg-[#0A0A0B]/80 border-b border-zinc-200/80 dark:border-zinc-800/80 transition-colors">
		<nav class="flex mx-auto max-w-5xl md:w-full justify-center gap-3 px-4 py-3 sm:px-6 md:flex-row md:items-center md:justify-between">
            <HomeLink/>
            <div class="ml-auto flex items-center space-x-2">
                <ThemeToggle/>
            </div>
        </nav>
	</header>
    <main class="mx-auto my-3 w-full max-w-5xl flex-1 px-2.5 md:px-5">
        <slot/>
    </main>
    <footer class="border-t border-zinc-200/80 dark:border-zinc-800/80 py-8">
		<Footer/>
	</footer>
</body>
</html>

<style>
  
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	
</style>