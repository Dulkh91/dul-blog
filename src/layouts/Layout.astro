---
import '../styles/global.css'
import Navbar from '@components/Navbar.astro'
import  Footer  from '@components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalPath?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  author?: string;
  keywords?: string[];
  noindex?: boolean;
}

const {
  title = 'DUL Blog',
  description = 'អត្ថបទ និងចំណេះដឹងថ្មីៗពី DUL Blog។',
  image,
  canonicalPath = Astro.url.pathname,
  type = 'website',
  publishedAt,
  author,
  keywords = [],
  noindex = false,
} = Astro.props;

const siteName = 'DUL Blog';
const fullTitle = title === siteName ? siteName : `${title} | ${siteName}`;
const canonicalUrl = new URL(canonicalPath, Astro.url.origin).toString();
const imageUrl = image ? new URL(image, Astro.url.origin).toString() : undefined;
---
<!doctype html>
<html lang="km">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<script is:inline>
			try {
				if (localStorage.getItem('blog-theme') === 'dark') document.documentElement.classList.add('dark');
			} catch {}
		</script>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
		{keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
		<link rel="canonical" href={canonicalUrl} />

		<meta property="og:type" content={type} />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		{imageUrl && <meta property="og:image" content={imageUrl} />}
		{type === 'article' && publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
		{type === 'article' && author && <meta property="article:author" content={author} />}

		<meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
		<meta name="twitter:url" content={canonicalUrl} />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		{imageUrl && <meta name="twitter:image" content={imageUrl} />}

	</head>
	<body class="bg-surface-light text-zinc-900 dark:bg-surface-dark dark:text-zinc-100 transition-colors duration-300 min-h-screen flex flex-col">
		<header class="sticky top-0 z-40 w-full  backdrop-blur-md bg-white/80 dark:bg-[#0A0A0B]/80 border-b border-zinc-200/80 dark:border-zinc-800/80 transition-colors">
			<Navbar/>
		</header>
		<main class="mx-auto my-3 w-full max-w-5xl flex-1 px-2.5 md:px-5">
			<slot />
		</main>

		<footer class="border-t border-zinc-200/80 dark:border-zinc-800/80 py-8">
			<Footer/>
		</footer>
	</body>
</html>

<style>
  
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	
</style>
