---
import '../styles/global.css'
import Navbar from '@components/Navbar.astro'
import  Footer  from '@components/Footer.astro';
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<script is:inline>
			try {
				if (localStorage.getItem('blog-theme') === 'dark') document.documentElement.classList.add('dark');
			} catch {}
		</script>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
	</head>
	<body class="bg-surface-light text-zinc-900 dark:bg-surface-dark dark:text-zinc-100 transition-colors duration-300 min-h-screen flex flex-col">
		<header class="sticky top-0 z-40 w-full  backdrop-blur-md bg-white/80 dark:bg-[#0A0A0B]/80 border-b border-zinc-200/80 dark:border-zinc-800/80 transition-colors">
			<Navbar/>
		</header>
		<main class="mx-auto my-3 w-full max-w-5xl flex-1 px-2.5 md:px-5">
			<slot />
		</main>

		<footer class="border-t border-zinc-200/80 dark:border-zinc-800/80 py-8">
			<Footer/>
		</footer>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
