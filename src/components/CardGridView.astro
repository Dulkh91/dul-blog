---
const { post} = Astro.props
import { timeAgo } from '@components/lib/date';
---

<a 
    href={post.category
        ? `/post/${encodeURIComponent(post.category.slug)}/${encodeURIComponent(post.slug)}`
        : `/post/${encodeURIComponent(post.slug)}`}
    data-astro-prefetch="viewport"
    class="group flex w-full cursor-pointer flex-col justify-between rounded-2xl border border-zinc-200/90 bg-white p-6 transition-all duration-200 hover:-translate-y-0.5 hover:border-zinc-400 dark:border-zinc-800/90 dark:bg-zinc-900 dark:hover:border-zinc-600 sm:p-7"
>
    <div>
        <!-- Top Meta Row -->
        <div class="flex items-center justify-between gap-2 mb-4">
            {post.category && (
                <span class="text-xs font-medium px-2.5 py-0.5 rounded-md bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-200/60 dark:border-zinc-700/60">
                    {post.category?.name}
                </span>
            )}
            <span class="text-xs font-mono text-zinc-400 dark:text-zinc-500">
                {timeAgo(post.createdAt) }
            </span>
        </div>

        <!-- Title -->
        <h3 class="text-lg sm:text-xl font-bold text-zinc-900 dark:text-zinc-100 leading-snug mb-3 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
            {post.title}
        </h3>

        <!-- Excerpt -->
        <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed line-clamp-2 mb-6">
            {post.excerpt}
        </p>
    </div>

    <!-- Footer Row -->
    <div class="pt-4 border-t border-zinc-100 dark:border-zinc-800/70 flex items-center justify-between text-xs">
        {post.author && (
            <span class="font-medium text-zinc-700 dark:text-zinc-300">
                {post.author?.name}
            </span>
        )}
        <span class="inline-flex items-center gap-1 font-medium text-zinc-500 dark:text-zinc-400 group-hover:text-zinc-900 dark:group-hover:text-white transition-colors">
            អានបន្ត <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
        </span>
    </div>
</a>
