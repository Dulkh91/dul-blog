---
import ButtonDelete from '@components/ButtonDelete';

interface Props {
  id: string;
  title: string;
  createdAt: string;
  category: CategoryProp | null;
  tags: { id: string; name: string }[];
  published: boolean;
}
type CategoryProp = {
  id: string;
  name: string;
  createdAt: string;
}

const { id, title, createdAt, category, tags, published } = Astro.props;
const date = new Intl.DateTimeFormat('km-KH', { dateStyle: 'medium' }).format(new Date(createdAt));
---

<article class="flex items-center justify-between gap-4 rounded-md border p-4 hover:shadow-md">
  <a
    href={`/dashboard/new-post?postId=${encodeURIComponent(id)}`}
    class="min-w-0 flex-1 rounded-md text-foreground no-underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
  >
    <h2 class="truncate font-medium">{title || 'គ្មានចំណងជើង'}</h2>
    <div class="mt-1 flex items-center gap-2 text-sm text-muted-foreground">
      <p>{date}</p>
      {category && <span class="rounded-sm border px-1">{category.name}</span>}
      {tags.map((tag) => <span class="rounded-sm border px-1">{tag.name}</span>)}
    </div>
  </a>
  <div class="flex shrink-0 items-center gap-3">
    <span class="rounded-full bg-muted px-3 py-1 text-xs text-muted-foreground">
      {published ? 'បានផ្សាយ' : 'Draft'}
    </span>
    <ButtonDelete client:load id={id} />
  </div>
</article>
