---
import Layout from '../layouts/Layout.astro';
import PostFeed from '@components/PostFeed';

export const prerender = false;

interface Post {
  id: string;
  title: string;
  excerpt: string | null;
  slug: string;
  author: { name: string } | null;
  category: { name: string; slug: string } | null;
  createdAt: Date;
}

interface PostResponse {
  posts?: Post[];
  error?: string;
  pagination?: { page: number; limit: number; total: number; totalPages: number };
}

const query = Astro.url.searchParams.get('q')?.trim() ?? '';
const category = Astro.url.searchParams.get('category') ?? '';
let posts: Post[] = [];
let error = '';
let totalPages = 1;

try {
  const postsUrl = new URL('/api/posts/posts', Astro.url);
  postsUrl.searchParams.set('page', '1');
  postsUrl.searchParams.set('limit', '10');
  if (query) postsUrl.searchParams.set('q', query);
  if (category) postsUrl.searchParams.set('category', category);

  const response = await fetch(postsUrl);
  const result = await response.json() as PostResponse;
  if (!response.ok) throw new Error(`Failed to fetch ${response.status}`);
  posts = result.posts ?? [];
  totalPages = result.pagination?.totalPages ?? 1;
} catch (cause) {
  console.error('Failed to fetch posts:', cause);
  error = cause instanceof Error ? cause.message : 'Failed to fetch posts';
}
---

<Layout>
  <div class="mx-auto w-full md:px-4 md:py-3">
    {error ? (
      <p role="alert" class="text-sm text-destructive">{error}</p>
    ) : (
      <PostFeed client:load initialPosts={posts} totalPages={totalPages} query={query} category={category} />
    )}
  </div>
</Layout>
