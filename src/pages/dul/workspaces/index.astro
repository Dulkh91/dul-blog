---
import DulLayout from "../../../layouts/DulLayout.astro";

export const prerender = false;

interface Workspace {
  id?: string;
  name: string;
  type: string;
  ownerUid: string;
  currency: string;
  createdAt: string | Date | null;
}

interface WorkspaceResponse {
  workspaces?: Workspace[];
  workspace?: Workspace[];
  error?: string;
}

const currentUser = Astro.locals.user;
let workspaces: Workspace[] = [];
let fetchError: string | null = null;

try {
  const apiUrl = new URL('/api/workspaces/workspace', Astro.url);
  if (currentUser?.id) {
    apiUrl.searchParams.set('ownerUid', currentUser.id);
  }

  const response = await fetch(apiUrl.toString(), {
    headers: {
      cookie: Astro.request.headers.get('cookie') ?? '',
    },
  });

  if (response.ok) {
    const result = (await response.json()) as WorkspaceResponse;
    workspaces = result.workspaces || result.workspace || [];
  } else {
    const errData = await response.json().catch(() => null);
    fetchError = errData?.error || `Error status: ${response.status}`;
  }
} catch (error) {
  console.error("Failed to fetch workspaces in SSR:", error);
  fetchError = "មិនអាចទាញយក Workspace ពី API បានទេ។";
}
---

<DulLayout title="Workspaces - Expand Track">
  <div class="max-w-6xl mx-auto px-4 py-8">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8 pb-6 border-b">
      <div>
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-gray-900 dark:text-white">
          Workspaces (Expand Track)
        </h1>
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
          គ្រប់គ្រង និងបង្កើត Workspace ដែលទាញយកពី Firebase Firestore API
        </p>
      </div>

      <button
        type="button"
        id="toggle-create-btn"
        class="inline-flex items-center justify-center gap-2 px-4 py-2 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow transition-colors"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        <span>បង្កើត Workspace ថ្មី</span>
      </button>
    </div>

    <!-- Create Workspace Form (Modal/Collapsible Card) -->
    <div
      id="create-workspace-card"
      class="hidden mb-8 p-6 bg-white dark:bg-zinc-900 rounded-xl border border-gray-200 dark:border-zinc-800 shadow-sm"
    >
      <div class="flex items-center justify-between mb-4 pb-3 border-b border-gray-100 dark:border-zinc-800">
        <h2 class="text-lg font-semibold text-gray-900 dark:text-white flex items-center gap-2">
          <span>➕</span> បង្កើត Workspace ថ្មី
        </h2>
        <button
          type="button"
          id="close-create-btn"
          class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 text-lg leading-none"
        >
          ✕
        </button>
      </div>

      <form id="create-workspace-form" class="space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Name -->
          <div>
            <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">
              ឈ្មោះ Workspace <span class="text-red-500">*</span>
            </label>
            <input
              type="text"
              name="name"
              required
              placeholder="ឧ. ការចំណាយផ្ទាល់ខ្លួន, អាជីវកម្ម..."
              class="w-full px-3 py-2 text-sm rounded-lg border border-gray-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500"
            />
          </div>

          <!-- Type -->
          <div>
            <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">
              ប្រភេទ Workspace
            </label>
            <select
              name="type"
              class="w-full px-3 py-2 text-sm rounded-lg border border-gray-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500"
            >
              <option value="personal">ផ្ទាល់ខ្លួន (Personal)</option>
              <option value="business">អាជីវកម្ម (Business)</option>
              <option value="team">ក្រុមការងារ (Team)</option>
              <option value="project">គម្រោង (Project)</option>
            </select>
          </div>

          <!-- Currency -->
          <div>
            <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">
              រូបិយប័ណ្ណ
            </label>
            <select
              name="currency"
              class="w-full px-3 py-2 text-sm rounded-lg border border-gray-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500"
            >
              <option value="USD">USD ($)</option>
              <option value="KHR">KHR (៛)</option>
              <option value="EUR">EUR (€)</option>
              <option value="THB">THB (฿)</option>
            </select>
          </div>

          <!-- Owner UID -->
          <div>
            <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">
              Owner UID
            </label>
            <input
              type="text"
              name="ownerUid"
              value={currentUser?.id || "anonymous"}
              placeholder="Firebase/User UID"
              class="w-full px-3 py-2 text-sm rounded-lg border border-gray-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500"
            />
          </div>
        </div>

        <!-- Alert messages -->
        <div id="form-message" class="hidden text-sm p-3 rounded-lg"></div>

        <div class="flex items-center justify-end gap-3 pt-2">
          <button
            type="button"
            id="cancel-create-btn"
            class="px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-zinc-800 hover:bg-gray-200 dark:hover:bg-zinc-700 rounded-lg transition-colors"
          >
            បោះបង់
          </button>
          <button
            type="submit"
            id="submit-create-btn"
            class="inline-flex items-center gap-2 px-5 py-2 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow transition-colors disabled:opacity-50"
          >
            <span id="submit-spinner" class="hidden animate-spin">⏳</span>
            <span>រក្សាទុក</span>
          </button>
        </div>
      </form>
    </div>

    <!-- Error message if any -->
    {fetchError && (
      <div class="mb-6 p-4 rounded-lg bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-900 text-red-700 dark:text-red-300 text-sm">
        ⚠️ <strong>កំហុស:</strong> {fetchError}
      </div>
    )}

    <!-- Workspace List -->
    <div>
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-semibold text-gray-900 dark:text-white">
          បញ្ជី Workspaces ({workspaces.length})
        </h2>
        <span class="text-xs font-mono text-gray-400 bg-gray-100 dark:bg-zinc-800 px-2.5 py-1 rounded">
          API: /api/firebase/expandtracks/workspace
        </span>
      </div>

      <div
        id="workspaces-container"
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"
      >
        {workspaces.map((item) => (
          <div class="p-5 bg-white dark:bg-zinc-900 rounded-xl border border-gray-200 dark:border-zinc-800 hover:border-blue-400 dark:hover:border-blue-600 transition shadow-sm flex flex-col justify-between">
            <div>
              <div class="flex items-start justify-between gap-2 mb-2">
                <h3 class="font-bold text-base text-gray-900 dark:text-white truncate">
                  {item.name}
                </h3>
                <span class="text-xs px-2 py-0.5 rounded font-medium bg-blue-100 text-blue-800 dark:bg-blue-900/40 dark:text-blue-300">
                  {item.type}
                </span>
              </div>

              <div class="space-y-1.5 text-xs text-gray-500 dark:text-gray-400 mt-3">
                <div class="flex items-center gap-1.5">
                  <span class="font-medium text-gray-700 dark:text-gray-300">រូបិយប័ណ្ណ:</span>
                  <span class="font-mono">{item.currency}</span>
                </div>
                <div class="flex items-center gap-1.5 truncate">
                  <span class="font-medium text-gray-700 dark:text-gray-300">Owner UID:</span>
                  <span class="font-mono truncate">{item.ownerUid}</span>
                </div>
              </div>
            </div>

            <div class="mt-4 pt-3 border-t border-gray-100 dark:border-zinc-800/80 flex items-center justify-between text-[11px] text-gray-400">
              <span>{item.createdAt ? new Date(item.createdAt).toLocaleDateString('km-KH') : 'N/A'}</span>
              <span class="text-blue-500 hover:underline cursor-pointer">មើលលម្អិត →</span>
            </div>
          </div>
        ))}
      </div>

      <!-- Empty State -->
      <div
        id="empty-state"
        class={`text-center py-12 bg-white dark:bg-zinc-900 rounded-xl border border-dashed border-gray-300 dark:border-zinc-800 mt-2 ${workspaces.length === 0 ? '' : 'hidden'}`}
      >
        <div class="text-4xl mb-3">📁</div>
        <h3 class="text-base font-medium text-gray-900 dark:text-white">មិនទាន់មាន Workspace នៅឡើយទេ</h3>
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-1 mb-4">
          ចុចប៊ូតុងខាងក្រោមដើម្បីបង្កើត Workspace ដំបូងរបស់អ្នក។
        </p>
        <button
          type="button"
          onclick="document.getElementById('toggle-create-btn')?.click()"
          class="inline-flex items-center gap-2 px-4 py-2 text-xs font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow transition-colors"
        >
          ➕ បង្កើត Workspace ឥឡូវនេះ
        </button>
      </div>
    </div>
  </div>
</DulLayout>




<script>
  const toggleBtn = document.getElementById('toggle-create-btn');
  const closeBtn = document.getElementById('close-create-btn');
  const cancelBtn = document.getElementById('cancel-create-btn');
  const card = document.getElementById('create-workspace-card');
  const form = document.getElementById('create-workspace-form') as HTMLFormElement | null;
  const messageEl = document.getElementById('form-message');
  const submitBtn = document.getElementById('submit-create-btn') as HTMLButtonElement | null;
  const spinner = document.getElementById('submit-spinner');
  const container = document.getElementById('workspaces-container');
  const emptyState = document.getElementById('empty-state');

  const openCard = () => {
    card?.classList.remove('hidden');
    form?.querySelector<HTMLInputElement>('input[name="name"]')?.focus();
  };

  const closeCard = () => {
    card?.classList.add('hidden');
    if (messageEl) {
      messageEl.className = 'hidden text-sm p-3 rounded-lg';
      messageEl.textContent = '';
    }
  };

  toggleBtn?.addEventListener('click', openCard);
  closeBtn?.addEventListener('click', closeCard);
  cancelBtn?.addEventListener('click', closeCard);

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !submitBtn) return;

    const formData = new FormData(form);
    const payload = {
      name: formData.get('name')?.toString().trim(),
      type: formData.get('type')?.toString().trim() || 'personal',
      currency: formData.get('currency')?.toString().trim() || 'USD',
      ownerUid: formData.get('ownerUid')?.toString().trim() || 'anonymous',
    };

    if (!payload.name) {
      showMessage('សូមបញ្ចូលឈ្មោះ Workspace!', false);
      return;
    }

    // Submit state
    submitBtn.disabled = true;
    spinner?.classList.remove('hidden');
    if (messageEl) messageEl.classList.add('hidden');

    try {
      const response = await fetch('/api/workspaces/workspace', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(payload),
      });

      const result = await response.json();

      if (response.ok && result.success) {
        showMessage('✅ បានបង្កើត workspace ដោយជោគជ័យ!', true);
        form.reset();

        // Dynamically append new card
        if (result.workspace && container) {
          emptyState?.classList.add('hidden');
          const newCard = document.createElement('div');
          newCard.className = 'p-5 bg-white dark:bg-zinc-900 rounded-xl border border-gray-200 dark:border-zinc-800 hover:border-blue-400 dark:hover:border-blue-600 transition shadow-sm flex flex-col justify-between animate-fade-in';
          newCard.innerHTML = `
            <div>
              <div class="flex items-start justify-between gap-2 mb-2">
                <h3 class="font-bold text-base text-gray-900 dark:text-white truncate">
                  ${result.workspace.name}
                </h3>
                <span class="text-xs px-2 py-0.5 rounded font-medium bg-blue-100 text-blue-800 dark:bg-blue-900/40 dark:text-blue-300">
                  ${result.workspace.type}
                </span>
              </div>
              <div class="space-y-1.5 text-xs text-gray-500 dark:text-gray-400 mt-3">
                <div class="flex items-center gap-1.5">
                  <span class="font-medium text-gray-700 dark:text-gray-300">រូបិយប័ណ្ណ:</span>
                  <span class="font-mono">${result.workspace.currency}</span>
                </div>
                <div class="flex items-center gap-1.5 truncate">
                  <span class="font-medium text-gray-700 dark:text-gray-300">Owner UID:</span>
                  <span class="font-mono truncate">${result.workspace.ownerUid}</span>
                </div>
              </div>
            </div>
            <div class="mt-4 pt-3 border-t border-gray-100 dark:border-zinc-800/80 flex items-center justify-between text-[11px] text-gray-400">
              <span>ថ្មីៗនេះ</span>
              <span class="text-blue-500 hover:underline cursor-pointer">មើលលម្អិត →</span>
            </div>
          `;
          container.prepend(newCard);
        }

        setTimeout(() => {
          closeCard();
        }, 1200);
      } else {
        showMessage(`❌ ${result.error || 'មានបញ្ហាក្នុងការបង្កើត workspace'}`, false);
      }
    } catch (err) {
      console.error(err);
      showMessage('❌ មិនអាចទាក់ទងទៅ server បានទេ', false);
    } finally {
      submitBtn.disabled = false;
      spinner?.classList.add('hidden');
    }
  });

  function showMessage(text: string, isSuccess: boolean) {
    if (!messageEl) return;
    messageEl.textContent = text;
    messageEl.className = `text-sm p-3 rounded-lg ${
      isSuccess
        ? 'bg-green-50 text-green-700 dark:bg-green-950/40 dark:text-green-300 border border-green-200 dark:border-green-800'
        : 'bg-red-50 text-red-700 dark:bg-red-950/40 dark:text-red-300 border border-red-200 dark:border-red-800'
    }`;
    messageEl.classList.remove('hidden');
  }
</script>
