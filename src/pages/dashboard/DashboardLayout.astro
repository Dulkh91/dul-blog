
---
import '../../styles/global.css'
import { DashboardShell } from '@components/dashboard-shell';
import { getSessionUser } from '../../lib/session';

export const prerender = false;

const user = await getSessionUser(Astro.cookies);
const userName = user?.name ?? user?.email ?? 'User name';
const userRole = user?.role ?? 'EDITOR';
---
<!DOCTYPE html>
<html lang="km">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DUL Blog Dashboard</title>
</head>
<body>

    <DashboardShell client:load userName={userName} userRole={userRole}>
      <slot />
    </DashboardShell>
    
</body>
</html>
