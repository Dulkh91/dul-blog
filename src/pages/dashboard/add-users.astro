---
import DashboardLayout from './DashboardLayout.astro';
import { prisma } from '../../lib/prisma';

export const prerender = false;

let message = '';
let messageType: 'success' | 'error' = 'success';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '').trim().toLowerCase();
  const name = String(form.get('name') ?? '').trim();
  const role = String(form.get('role') ?? '');

  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
    message = 'សូមបញ្ចូលអ៊ីមែលឲ្យបានត្រឹមត្រូវ។';
    messageType = 'error';
  } else if (role !== 'ADMIN' && role !== 'EDITOR') {
    message = 'សូមជ្រើសរើស role ត្រឹមត្រូវ។';
    messageType = 'error';
  } else {
    try {
      const existing = await prisma.user.findUnique({ where: { email } });
      if (existing) {
        message = 'អ៊ីមែលនេះមានក្នុងបញ្ជីរួចហើយ។ សូមកែពីតារាងខាងក្រោម។';
        messageType = 'error';
      }

      if (!message) {
        await prisma.user.create({ data: { email, name: name || null, role } });
        return Astro.redirect('/dashboard/add-users?saved=1', 303);
      }
    } catch (error) {
      console.error('Could not save dashboard user:', error);
      message = 'មិនអាចរក្សាទុកអ្នកប្រើបានទេ។ សូមពិនិត្យ database។';
      messageType = 'error';
    }
  }
}

if (Astro.url.searchParams.get('saved') === '1') message = 'បានរក្សាទុកអ្នកប្រើក្នុង database។';

const users = await prisma.user.findMany({
  select: { id: true, name: true, email: true, role: true, googleId: true },
  orderBy: [{ role: 'asc' }, { email: 'asc' }],
});
---

<DashboardLayout>
  <section class="mx-auto max-w-4xl space-y-6">
    <header>
      <h1 class="text-2xl font-semibold">បន្ថែមអ្នកប្រើ</h1>
      <p class="mt-1 text-sm text-muted-foreground">បន្ថែមអ៊ីមែល Google និងជ្រើសរើសសិទ្ធិ Admin ឬ Editor។</p>
    </header>

    {message && (
      <p role={messageType === 'error' ? 'alert' : 'status'} class:list={[
        'rounded-md border px-4 py-3 text-sm',
        messageType === 'error' ? 'border-red-300 text-red-700 dark:text-red-300' : 'border-emerald-300 text-emerald-700 dark:text-emerald-300',
      ]}>{message}</p>
    )}

    <form method="post" class="grid gap-4 rounded-xl border p-5 sm:grid-cols-2">
      <label class="space-y-1 text-sm">
        <span>ឈ្មោះ</span>
        <input name="name" type="text" autocomplete="name" class="w-full rounded-md border bg-background px-3 py-2" placeholder="ឈ្មោះអ្នកប្រើ" />
      </label>
      <label class="space-y-1 text-sm">
        <span>អ៊ីមែល Google</span>
        <input name="email" type="email" required autocomplete="email" class="w-full rounded-md border bg-background px-3 py-2" placeholder="name@example.com" />
      </label>
      <label class="space-y-1 text-sm sm:col-span-2">
        <span>Role</span>
        <select name="role" required class="w-full rounded-md border bg-background px-3 py-2">
          <option value="EDITOR">Editor</option>
          <option value="ADMIN">Admin</option>
        </select>
      </label>
      <button type="submit" class="rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground sm:col-span-2 sm:justify-self-start">រក្សាទុកអ្នកប្រើ</button>
    </form>

    <div class="overflow-x-auto rounded-xl border">
      <table class="w-full text-left text-sm">
        <thead class="bg-muted/60">
          <tr><th class="px-4 py-3">ឈ្មោះ</th><th class="px-4 py-3">អ៊ីមែល</th><th class="px-4 py-3">Role</th><th class="px-4 py-3">សកម្មភាព</th></tr>
        </thead>
        <tbody class="divide-y">
          {users.map((user) => {
            const formId = `edit-user-${user.id}`;
            return (
            <tr>
              <td class="px-4 py-3"><input form={formId} name="name" value={user.name ?? ''} class="w-36 rounded border bg-background px-2 py-1" aria-label={`ឈ្មោះ ${user.email}`} /></td>
              <td class="px-4 py-3"><input form={formId} name="email" type="email" value={user.email} readonly={Boolean(user.googleId)} class="w-56 rounded border bg-background px-2 py-1 read-only:opacity-60" aria-label={`អ៊ីមែល ${user.email}`} /></td>
              <td class="px-4 py-3">
                <select form={formId} name="role" value={user.role} class="rounded border bg-background px-2 py-1" aria-label={`Role ${user.email}`}>
                  <option value="EDITOR">Editor</option>
                  <option value="ADMIN">Admin</option>
                </select>
                {user.googleId && <p class="mt-1 text-xs text-muted-foreground">Google linked</p>}
              </td>
              <td class="px-4 py-3">
                <form id={formId} class="edit-user-form" data-user-id={user.id}>
                  <button type="submit" class="rounded-md border px-3 py-1.5 text-sm hover:bg-muted">កែប្រែ</button>
                  <p class="edit-user-message mt-1 text-xs" role="status"></p>
                </form>
              </td>
            </tr>
          );})}
        </tbody>
      </table>
    </div>
  </section>
</DashboardLayout>

<script>
  document.querySelectorAll<HTMLFormElement>('.edit-user-form').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const message = form.querySelector<HTMLElement>('.edit-user-message');
      const payload = Object.fromEntries(new FormData(form).entries());

      try {
        const response = await fetch('/api/admin/users', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: form.dataset.userId, ...payload }),
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error ?? 'មិនអាចកែអ្នកប្រើបានទេ។');
        if (message) {
          message.textContent = 'បានកែប្រែ។';
          message.className = 'edit-user-message mt-1 text-xs text-emerald-700';
        }
      } catch (error) {
        if (message) {
          message.textContent = error instanceof Error ? error.message : 'មិនអាចកែអ្នកប្រើបានទេ។';
          message.className = 'edit-user-message mt-1 text-xs text-red-700';
        }
      }
    });
  });
</script>
