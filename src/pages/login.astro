---
import Layout from '../layouts/Layout.astro';
import { getSessionUser } from '../lib/session';

export const prerender = false;

const user = await getSessionUser(Astro.cookies);
const loginError = Astro.url.searchParams.get('error');
const returnTo = Astro.url.searchParams.get('returnTo') ?? '/dashboard';
const loginErrorMessage = {
  not_allowed: 'អ៊ីមែល Google នេះមិនមានសិទ្ធិចូលទេ។',
  provider: 'Google បានបដិសេធការចូល។ សូមចាប់ផ្ដើមម្ដងទៀត។',
  state: 'សុពលភាព login ផុតកំណត់។ សូមចាប់ផ្ដើមម្ដងទៀត។',
  token: 'មិនអាចផ្ទៀងផ្ទាត់ code ពី Google បានទេ។ សូមពិនិត្យ callback URL និងសាកម្ដងទៀត។',
  profile: 'មិនអាចទាញយក Google profile ឬអ៊ីមែលដែលបានផ្ទៀងផ្ទាត់បានទេ។',
  database: 'មិនអាចរក្សាទុកអ្នកប្រើបានទេ។ សូមពិនិត្យ database និង Prisma schema។',
  session: 'មិនអាចបង្កើត session បានទេ។ សូមពិនិត្យ GOOGLE_CLIENT_ID និង GOOGLE_CLIENT_SECRET។',
} as const;
const errorMessage = loginError && loginError in loginErrorMessage
  ? loginErrorMessage[loginError as keyof typeof loginErrorMessage]
  : 'ការចូលដោយ Google មិនបានជោគជ័យទេ។ សូមសាកល្បងម្ដងទៀត។';
---

<Layout>
  <main class="mx-auto mt-12 max-w-md rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
    <h1 class="text-2xl font-semibold">ចូលគណនី</h1>
    {user ? (
      <div class="mt-5 space-y-4">
        <p class="text-sm text-zinc-600 dark:text-zinc-300">បានចូលជា {user.name ?? user.email}</p>
        <div class="flex gap-3">
          <a href="/dashboard" class="rounded-lg bg-zinc-900 px-4 py-2 text-sm font-medium text-white dark:bg-white dark:text-zinc-900">ទៅ Dashboard</a>
          <button id="sign-out" type="button" class="rounded-lg border px-4 py-2 text-sm">ចាកចេញ</button>
        </div>
      </div>
    ) : (
      <div class="mt-5 space-y-4">
        {loginError && <p role="alert" class="text-sm text-red-600">{errorMessage}</p>}
        <a href={`/api/auth/google/google?returnTo=${encodeURIComponent(returnTo)}`} class="flex items-center justify-center rounded-lg border border-zinc-300 px-4 py-3 text-sm font-medium hover:bg-zinc-50 dark:border-zinc-700 dark:hover:bg-zinc-800">
          បន្តជាមួយ Google
        </a>
      </div>
    )}
  </main>
</Layout>

<script>
  const signOutButton = document.querySelector<HTMLButtonElement>('#sign-out');
  signOutButton?.addEventListener('click', async () => {
    const response = await fetch('/api/auth/google/logout', { method: 'POST' });
    if (response.ok) window.location.assign('/login');
  });
</script>
