---
import Layout from '../../../layouts/Layout.astro';
import '../../../styles/global.css';
import { prisma } from '../../../lib/prisma';
import BackTop from '@components/BackTop';


import { formatDate,formatTime } from '@components/lib/date'
import {CalendarDays,User,Clock} from 'lucide-react'

export const prerender = false;

interface DisplayPost {
  title: string;
  content: string;
  createdAt: Date;
  author: { name: string } | null;
  category: { name: string; slug: string } | null;
  tags: { id: string; name: string }[];
}

const categorySlug = Astro.params.category;
const slug = Astro.params.slug;
let post: DisplayPost | null = null;
let loadError = false;

try {
  if (categorySlug && slug) {
    post = await prisma.post.findFirst({
      where: { slug, published: true, category: { slug: categorySlug } },
      include: {
        author: { select: { name: true } },
        category: { select: { name: true, slug: true } },
        tags: { select: { id: true, name: true } },
      },
    });
  }
} catch (error) {
  console.error(`Failed to load post "${slug}" in category "${categorySlug}":`, error);
  loadError = true;
}

if (loadError) Astro.response.status = 500;
else if (!post) Astro.response.status = 404;

---

<Layout>
  {loadError ? (
    <p role="alert">មិនអាចទាញយកអត្ថបទបានទេ។ សូមសាកល្បងម្ដងទៀត។</p>
  ) : post ? (
    <div class=" w-full min-w-0">
      <a
        href={`/?category=${encodeURIComponent(categorySlug ?? '')}`}
        class="text-sm text-muted-foreground hover:underline"
      >
        ← ត្រឡប់ទៅ Category
      </a>
      <header class="mt-6 space-y-3 border-b pb-6">
        <h3 class=" text-xl md:text-3xl font-bold">{post.title}</h3>
        <div class="flex flex-wrap items-center gap-2 text-xs md:text-sm text-muted-foreground">
          <CalendarDays size={14}/>  {formatDate(post.createdAt)} <Clock size={14}/> {formatTime(post.createdAt)}
          {post.author && <User size={14}/><span> {post.author.name}</span>}
          {/* {post.category && <span class="rounded border px-2 py-0.5">{post.category.name}</span>} */}
        </div>
      </header>
      <article class="prose prosee-sm md:prose-lg dark:prose-invert mt-2 max-w-none rounded-xl bg-white p-6 dark:bg-zinc-900 sm:p-8" set:html={post.content} />
      {post.tags.length > 0 && (
          <ul class="flex flex-wrap border-t border-gray-200 dark:border-0 rounded-t-xl transition-colors duration-300 bg-white p-2 dark:bg-zinc-900 mt-2 gap-2">
            <li class=" bg-white  dark:bg-zinc-900 transition-colors duration-300 px-2">Tag:</li>
            {post.tags.map((tag) => <li class="rounded-full border px-2 py-1 text-xs">{tag.name}</li>)}
          </ul>
        )}
    </div>
  ) : (
    <section>
      <h1 class="text-2xl font-semibold">រកមិនឃើញអត្ថបទនេះទេ</h1>
      <p class="mt-2 text-muted-foreground">អត្ថបទអាចមិនមានក្នុង category នេះ ឬមិនទាន់បានផ្សាយ។</p>
      <a
        href={`/?category=${encodeURIComponent(categorySlug ?? '')}`}
        class="mt-4 inline-block underline"
      >
        ត្រឡប់ទៅ Category
      </a>
    </section>
  )}
  <BackTop  client:load/>
</Layout>


<!-- Create Code Highlighter with Prism -->
<script >
 import '../../../javascript/prism'
</script>

